draw_sprite(spr_logo,0,480+irandom_range(-1,1),(540*0.38)+irandom_range(-1,1))
draw_set_font(global.creditsfont)
draw_set_halign(1)
draw_set_valign(0)
draw_textEX(480, (540*0.8), "[wave][J] TO START (NORMAL)")
draw_textEX(480, (540*0.9), "[wave][T] TO START (DEV HOTEL)")
draw_set_halign(0)