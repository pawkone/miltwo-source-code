draw_clear(c_black)
draw_set_alpha(1)
draw_set_colour(c_white)
draw_set_font(-1)
draw_set_halign(0)
draw_set_valign(2)
draw_text(25,525,$"MILTWO PUBLIC PLAYTEST - BUILD DATE : {date_datetime_string(GM_build_date)}")
draw_set_valign(0)
for (var i = 0; i < array_length(opt); i++)
	draw_text(128,128+i*24,(select == i ? "> " : "  ") + opt[i])