draw_clear(c_black)
draw_set_colour(c_white)
draw_set_alpha(1)
draw_sprite(spr_logo,0,480+irandom_range(-1,1),(540*0.38)+irandom_range(-1,1))
draw_set_font(global.creditsfont)
draw_set_halign(1)
draw_set_valign(0)
draw_textEX(480, (540*0.88), "[wave][J] TO START")
draw_textEX(480, (540*0.72), $"[wave2]{date_date_string(GM_build_date)}")
draw_set_halign(0)